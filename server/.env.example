PORT=5000
APP_ENV=development

# MongoDB Atlas connection string WITHOUT a trailing slash or query string
# (the code appends "/zibook" itself)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

CLDN_NAME=
CLDN_API_KEY=
CLDN_API_SECRET=
